# Copy to .env. Local .env files are ignored by the root .gitignore.
# Use simulated to run without Ollama; use ollama for your installed model.
LLM_FALLBACK_MODE=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# Maximum shared local-Q&A and Ollama answer entries per process.
CACHE_CAPACITY=10

# Opt-in: evaluate on your questions before enabling paraphrase reuse.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.90

# Fixed lifetime from insertion, in seconds; hits do not renew it.
CACHE_TTL_SECONDS=3600
# Optional bearer secret for POST /cache/clear. Empty disables administration.
CACHE_ADMIN_TOKEN=

# Optional bearer secret for GET /metrics. Empty disables metrics access.
METRICS_TOKEN=
