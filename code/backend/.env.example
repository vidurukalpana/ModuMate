# Copy to .env. Local .env files are ignored by the root .gitignore.
# Use simulated to run without Ollama; use ollama for your installed model.
LLM_FALLBACK_MODE=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# Question-response rows per process, shared by local-Q&A and Ollama answers.
CACHE_CAPACITY=4

# Reuse a cached answer when cosine similarity is greater than the threshold
# and both questions name the same technical terms.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.75

# Empty or 0 disables time-based expiration; a positive value is seconds from insertion.
CACHE_TTL_SECONDS=0
# Optional bearer secret for POST /cache/clear. Empty disables administration.
CACHE_ADMIN_TOKEN=

# Optional bearer secret for GET /metrics. Empty disables metrics access.
METRICS_TOKEN=

# Per-process request concurrency; model inference remains serialized.
REQUEST_MAX_ACTIVE=2
REQUEST_MAX_WAITING=8
OLLAMA_MAX_CONCURRENT=1
REQUEST_WAIT_SECONDS=120
